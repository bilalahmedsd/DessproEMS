@using EMS.UI.Models
@{
    Layout = null;
}
@model LoginModel;
@inject IConfiguration configuration
@{
    var sitekey = configuration["reCaptchaSettings:SiteKey"];
}
@if (TempData["LoginSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["LoginSuccess"]
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <p style="color: red;">@ViewBag.ErrorMessage</p>
}

<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <style>
        /* Custom Styles */
        body {
            background: linear-gradient(to left, navy 20%, #030e3e);
        }

        /* Heading Adjustment */
        h1 {
            font-size: 26px;
            font-weight: bold;
        }

        /* Glassmorphism Login Box */
        .login-box {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: center;
            min-height: 450px; /* Reduced height */
        }

        /* Logo */
        .logo {
            width: 200px;
            height: 50px;
            border-radius: 7px;
        }

        /* Input Fields */
        .custom-input {
            background: transparent;
            border: 2px solid rgba(255, 255, 255, 0.5);
            border-radius: 30px;
            color: white;
            text-align: center;
            padding: 8px; /* Reduced height */
            font-size: 16px;
            width: 90%;
            margin: auto;
        }

            /* Input Placeholder */
            .custom-input::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }

            /* Input Focus */
            .custom-input:focus {
                border-color: #2575fc;
                box-shadow: 0 0 10px rgba(37, 117, 252, 0.5);
            }

        /* Button */
        .custom-btn {
            background: linear-gradient(to right, #2575fc, #6a11cb);
            border: none;
            border-radius: 30px;
            font-size: 17px;
            font-weight: bold;
            transition: 0.3s;
            padding: 10px;
            width: 90%;
            margin: auto;
        }

            /* Button Hover */
            .custom-btn:hover {
                background: linear-gradient(to right, #6a11cb, #2575fc);
                box-shadow: 0 0 15px rgba(106, 17, 203, 0.5);
            }

        .recaptcha-container {
            display: flex;
            justify-content: center;
            transform: scale(0.9); /* Default Scale */
            transform-origin: center;
        }

        #errorMsg {
            position: relative;
            display: block;
            min-height: 20px; /* Space reserve karne ke liye */
        }

        @@media (max-width: 768px) {
            .recaptcha-container {
                transform: scale(0.85); /* Adjust scale for tablets */
            }
        }

        @@media (max-width: 480px) {
            .recaptcha-container {
                transform: scale(0.75); /* Adjust scale for mobile */
            }
        }
    </style>
</head>

<body class="d-flex justify-content-center align-items-center vh-100 bg-dark">

    <div class="container">
        <!-- Properly Centered Heading -->
        <h1 class="text-center text-white mb-4">Energy Management System</h1>

        <div class="row justify-content-center align-items-center">
            <!-- Left Side Image -->
            <div class="col-md-6 text-center d-none d-md-block">
                <img src="~/assets/media/logos/Adobe.png" alt="Login Illustration" class="img-fluid">
            </div>

            <!-- Right Side Login Form -->
            <div class="col-md-6 col-lg-4">
                <div class="login-box p-4 rounded shadow-lg">
                    <div class="text-center mb-3">
                        <img src="~/assets/media/logos/defcologo.jpeg" alt="Company Logo" class="logo mb-2">
                        <h2 class="text-white">Login</h2>
                    </div>
                    <form id="loginForm" method="post" onsubmit="onSubmit(event)">
                        <input type="hidden" id="recaptchaTokenInputId" name="RecaptchaToken" asp-for="RecaptchaToken" />

                        <div class="mb-4">
                            <input type="text" class="form-control custom-input" id="username" asp-for="Username" placeholder="Username" required>
                        </div>
                        <div class="mb-4">
                            <input type="password" class="form-control custom-input" id="password" asp-for="Pass" placeholder="Password" required>
                        </div>
                        <div class="recaptcha-container">
                            <div id="html_element"></div>
                        </div>

                        <!-- Error message will now be inside the form -->
                        <div id="errorMsg" class="text-danger mt-2 text-center"></div>

                        <button type="submit" class="btn btn-primary w-100 custom-btn">Login</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript">
        var onloadCallback = function() {
            grecaptcha.render('html_element', {
              'sitekey' : '@sitekey'
            });
        };
        function onSubmit(event){
                 var token = grecaptcha.getResponse();
                 document.getElementById("recaptchaTokenInputId").value = token
        }
    </script>

    <script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit"
            async defer>
    </script>
</body>

</html>


